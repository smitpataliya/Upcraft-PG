# Upcraft PG Backend Environment Variables
SPRING_PROFILES_ACTIVE=dev

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pg_management
DB_USER=root
DB_PASSWORD=Admin@123

# JWT (Base64-encoded 256-bit+ secret)
JWT_SECRET=replace-with-base64-encoded-256-bit-secret

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# Google SSO (Optional)
GOOGLE_CLIENT_ID=

# SMTP Mail (Optional for OTP emails)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Flyway Safe Baseline (true only when adopting pre-existing unbaselined MySQL schema)
FLYWAY_BASELINE_ON_MIGRATE=true
PORT=8080

